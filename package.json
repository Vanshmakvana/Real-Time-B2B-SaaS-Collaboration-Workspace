{
  "name": "infotact-collaboration-workspace",
  "version": "1.0.0",
  "description": "Real-Time B2B SaaS Collaboration Workspace",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "client:dev": "npm run dev --workspace=client",
